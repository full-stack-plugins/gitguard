{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen local advisory task scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "requirement_ids",
    "allowed_paths",
    "policy_digest",
    "baseline_digest"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_digest": {
      "type": "null"
    }
  },
  "$comment": "TaskScope::validate additionally rejects unsafe path components and unsorted IDs. Caller-frozen local policy only, never approval authority. Protected local controller audit descriptor is defined in $defs; root legacy TaskScope schema is unchanged. Descriptor JSON never creates a protected value.",
  "$defs": {
    "protectedDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "trust_profile",
        "advisory",
        "repo_id",
        "root",
        "common_dir",
        "object_format",
        "task_id",
        "requirement_ids",
        "allowed_paths",
        "policy",
        "baseline"
      ],
      "properties": {
        "schema_version": {
          "const": "gitguard.protected-scope/v1alpha1"
        },
        "trust_profile": {
          "const": "local-controller-source-only"
        },
        "advisory": {
          "const": true
        },
        "repo_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "root": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "common_dir": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "allowed_paths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "blob_oid",
            "mode"
          ],
          "properties": {
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commit_oid",
                "path",
                "digest"
              ],
              "properties": {
                "commit_oid": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "path": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4096,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "blob_oid": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "mode": {
              "enum": [
                "100644",
                "100755"
              ]
            }
          }
        },
        "baseline": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference",
                "blob_oid",
                "mode"
              ],
              "properties": {
                "reference": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "commit_oid",
                    "path",
                    "digest"
                  ],
                  "properties": {
                    "commit_oid": {
                      "type": "string",
                      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                    },
                    "path": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4096,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      }
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "blob_oid": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "mode": {
                  "enum": [
                    "100644",
                    "100755"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "requirement_ids",
        "allowed_paths"
      ],
      "properties": {
        "schema_version": {
          "const": "gitguard.scope-policy/v1alpha1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "allowed_paths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      }
    }
  }
}
