{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen local advisory task scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "requirement_ids",
    "allowed_paths",
    "policy_digest",
    "baseline_digest"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_digest": {
      "type": "null"
    }
  },
  "$comment": "TaskScope::validate additionally rejects unsafe path components and unsorted IDs. Caller-frozen local policy only, never approval authority."
}
